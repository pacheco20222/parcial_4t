flowchart LR
    ciudadano([Ciudadano<br/>navegador móvil])
    operador([Operador municipal<br/>web / móvil])
    supervisor([Supervisor / Administrador])
    analista([Analista SOC])
    subgraph sis[Sistema de Monitoreo de Inundaciones de Mérida]
        core[Plataforma de Monitoreo<br/>y Alerta Temprana]
    end
    sensores[[Sensores de campo<br/>simulados: profundidad + lluvia]]
