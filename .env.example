# Compose substitutions only. Passwords/keys are generated files, never env values.
SITE_ADDRESS=localhost
GATEWAY_HTTPS_PORT=8443
GATEWAY_HTTP_PORT=8080
# Compose defaults to prod (docs/OpenAPI disabled); dev explicitly enables them.
ENVIRONMENT=dev
OPEN_METEO_ENABLED=true
SECURITY_ENFORCE_MFA=false
# Site gate (public demo): GATE_MODE=on puts Caddy basic_auth in front of everything.
# Password: secrets/gate_password (scripts/bootstrap.sh). Off by default for local dev.
GATE_MODE=off
# TLS: internal (local CA) | acme (Let's Encrypt; public VPS with ports 80/443)
TLS_MODE=internal
GATE_USER=demo
SCENARIO=cycle
INTERVAL_SECONDS=60
# Demo speed: INTERVAL_SECONDS=5 (intentionally exceeds normal sensor rate).
# Container env (set in docker-compose.yml; not host substitutions):
# telemetry-service :8000
# DATABASE_HOST=postgres
# DATABASE_NAME=flood
# DATABASE_USER=telemetry_svc
# DATABASE_PASSWORD_FILE=/run/secrets/telemetry_db_password
# REDIS_HOST=redis
# REDIS_PASSWORD_FILE=/run/secrets/redis_password
# MQTT_HOST=mosquitto
# MQTT_PORT=8883
# MQTT_USERNAME=svc-telemetry
# MQTT_PASSWORD_FILE=/run/secrets/mqtt_telemetry_password
# MQTT_CA_FILE=/run/secrets/ca.crt
# JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public.pem
# OPEN_METEO_ENABLED=true
# ENVIRONMENT=dev
# ops-service :8080
# Database__Host=postgres
# Database__Name=flood
# Database__User=ops_svc
# Database__PasswordFile=/run/secrets/ops_db_password
# Redis__Host=redis
# Redis__PasswordFile=/run/secrets/redis_password
# Jwt__PrivateKeyFile=/run/secrets/jwt_private.pem
# Jwt__PublicKeyFile=/run/secrets/jwt_public.pem
# Seed__AdminPasswordFile=/run/secrets/seed_admin_password
# Seed__SupervisorPasswordFile=/run/secrets/seed_supervisor_password
# Seed__OperatorPasswordFile=/run/secrets/seed_operator_password
# Security__EnforceMfa=false
# simulator (SCENARIO and INTERVAL_SECONDS above)
# MQTT_HOST=mosquitto
# MQTT_PORT=8883
# MQTT_CA_FILE=/run/secrets/ca.crt
# MQTT_DEVICES_FILE=/run/secrets/mqtt_devices.json
