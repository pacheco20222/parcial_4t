{
	admin localhost:2019
	auto_https disable_redirects
	servers {
		# Only peer allowed to set X-Forwarded-For: the edge_net gateway (the host's nginx on the VPS, via 127.0.0.1).
		trusted_proxies static 172.30.0.1/32
	}
}

# Site gate (temporary public demo): GATE_MODE=on puts basic_auth in front of everything.
# Basic credentials are removed before proxying so upstreams never see them.
(gate-on) {
	basic_auth {
		{$GATE_USER:demo} {file./run/secrets/gate_password_hash}
	}
	request_header -Authorization
}
(gate-off) {
	# no gate
}

# TLS: TLS_MODE=internal (local CA, default) or acme (Let's Encrypt on the public VPS; needs 80/443 open).
(tls-internal) {
	tls internal
}
(tls-acme) {
	# automatic HTTPS via ACME
}

http://{$SITE_ADDRESS:localhost} {
	redir https://{host}:{$GATEWAY_HTTPS_PORT:8443}{uri} 308
}

https://{$SITE_ADDRESS:localhost} {
	import tls-{$TLS_MODE:internal}
	import gate-{$GATE_MODE:off}
	@app not path /soc/*
	header @app Content-Security-Policy "default-src 'self'; style-src 'self' 'nonce-{http.request.uuid}'; connect-src 'self'; img-src 'self' data: https://*.tile.openstreetmap.org; frame-ancestors 'none'"
	# Grafana's UI needs inline styles/scripts and eval: relaxed CSP scoped to the admin-only SOC console.
	header /soc/* Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	request_body {
		max_size 1MB
	}
	log {
		output stdout
		format json
	}
	handle_path /api/telemetry/* {
		reverse_proxy telemetry-service:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle_path /api/ops/* {
		reverse_proxy ops-service:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle /hubs/* {
		# reverse_proxy upgrades WebSocket connections automatically.
		reverse_proxy ops-service:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle /soc/* {
		reverse_proxy grafana:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	# Missing build assets must remain 404s, never index.html.
	@static path *.js *.mjs *.css *.map *.woff *.woff2 *.ttf *.otf *.eot *.png *.jpg *.jpeg *.gif *.svg *.ico *.webp *.avif *.wasm *.json *.txt *.xml /media/* /assets/*
	handle @static {
		root * /srv/www
		@hashed {
			path_regexp hashed ^/.*-[A-Za-z0-9_-]{8,}\.[^/]+$
			file {path}
		}
		# Preserve header order: existing hashed files override the default.
		route {
			header Cache-Control "no-cache"
			header @hashed Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}
	handle {
		header Cache-Control "no-cache"
		root * /srv/www
		try_files {path} /index.html
		# Fills the per-request CSP nonce ({http.request.uuid}) into index.html (ngCspNonce).
		templates
		file_server
	}
}
