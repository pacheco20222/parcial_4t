{
	admin localhost:2019
	auto_https disable_redirects
}

http://{$SITE_ADDRESS:localhost} {
	redir https://{host}:{$GATEWAY_HTTPS_PORT:8443}{uri} 308
}

https://{$SITE_ADDRESS:localhost} {
	tls internal
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: https://*.tile.openstreetmap.org; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	request_body {
		max_size 1MB
	}
	log {
		output stdout
		format json
	}
	handle_path /api/telemetry/* {
		reverse_proxy telemetry-service:8000
	}
	handle_path /api/ops/* {
		reverse_proxy ops-service:8080
	}
	handle /hubs/* {
		# reverse_proxy upgrades WebSocket connections automatically.
		reverse_proxy ops-service:8080
	}
	handle /soc/* {
		reverse_proxy grafana:3000
	}
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
